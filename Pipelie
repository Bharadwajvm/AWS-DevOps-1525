pipeline {
 agent any
 tools {
 maven 'Maven3' // name configured in Manage Jenkins > Tools
 jdk 'JDK17'
 }
 stages {
 stage('Checkout') {
 steps {
 git branch: 'main',
 url: 'https://github.com/<your-user>/<maven-web-app>.git'
 }
 }
 stage('Build') {
 steps {
 sh 'mvn clean package'
 }
 }
 stage('Archive') {
 steps {
 archiveArtifacts artifacts: 'target/*.war', fingerprint: true
 }
 }
 }
}
